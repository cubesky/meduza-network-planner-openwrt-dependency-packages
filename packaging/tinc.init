#!/bin/sh /etc/rc.common
START=90
USE_PROCD=1
start_instance() {
    local section="$1" enabled confdir
    config_get_bool enabled "$section" enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get confdir "$section" confdir "/etc/tinc/$section"
    procd_open_instance "$section"
    procd_set_param command /usr/sbin/tincd -D -c "$confdir"
    procd_set_param respawn
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
start_service() {
    config_load tinc
    config_foreach start_instance tinc
}
