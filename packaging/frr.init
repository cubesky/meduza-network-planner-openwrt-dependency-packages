#!/bin/sh /etc/rc.common
START=90
USE_PROCD=1
start_service() {
    local daemon DAEMONS
    DAEMONS='mgmtd zebra staticd bgpd bfdd ospfd'
    [ ! -r /etc/frr/daemons ] || . /etc/frr/daemons
    mkdir -p /var/run/frr
    for daemon in $DAEMONS; do
        [ -x "/usr/sbin/$daemon" ] || continue
        procd_open_instance "$daemon"
        procd_set_param command "/usr/sbin/$daemon" -f /etc/frr/frr.conf
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    done
}
